{
  "name": "mom-mary",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/helpers/register-ts.mjs --test --test-concurrency=1 \"tests/**/*.test.mjs\"",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/helpers/register-ts.mjs --test --test-concurrency=1 \"tests/unit/*.test.mjs\"",
    "test:integration": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/helpers/register-ts.mjs --test --test-concurrency=1 \"tests/integration/*.test.mjs\"",
    "test:super-admin": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/helpers/register-ts.mjs --test --test-concurrency=1 tests/integration/super-admin.test.mjs",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/apply-sql-migration.mjs",
    "db:migrate:platform": "node scripts/migrate-platform.mjs",
    "db:check:platform": "node scripts/migrate-platform.mjs --check",
    "db:verify:platform": "node scripts/verify-platform-db.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/analytics": "^2.0.1",
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.3",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "framer-motion": "^14.6.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "next": "16.4.6",
    "nodemailer": "^10.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
